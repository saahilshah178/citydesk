{
  "name": "open311-mcp",
  "version": "0.1.0",
  "description": "City-agnostic MCP server and typed client for Open311 GeoReport v2 (311 service requests), with sandbox-only write guards.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saahilshah178/citydesk.git",
    "directory": "packages/open311-mcp"
  },
  "homepage": "https://github.com/saahilshah178/citydesk/tree/main/packages/open311-mcp#readme",
  "bugs": {
    "url": "https://github.com/saahilshah178/citydesk/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "open311",
    "georeport",
    "311",
    "civic-tech",
    "seeclickfix"
  ],
  "bin": {
    "open311-mcp": "dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples.cities.json",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
