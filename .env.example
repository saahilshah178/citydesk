# Copy to .env (never commit .env). Keys live only in environment variables or SSM Parameter Store.

# --- AWS ---------------------------------------------------------------
AWS_REGION=us-east-1
# Bedrock model (or inference profile) ID used by the assistant through the Converse API.
BEDROCK_MODEL_ID=
# Amazon Location Service place index used for geocoding. `make deploy` creates "citydesk-places";
# set that name here to use it locally. Empty: street addresses are resolved from Boston's own
# address records, with no AWS needed (landmarks and intersections then are not understood).
LOCATION_PLACE_INDEX=
# DynamoDB table for each user's filed and followed requests (created by infra/).
CITYDESK_TABLE=citydesk-user-requests
# Amazon Polly voice for spoken replies.
POLLY_VOICE_ID=Joanna

# Set to "off" to skip Amazon Location map images on the issue card.
CITYDESK_STATIC_MAPS=

# --- Duplicate check ---------------------------------------------------
# An open request of the same type within this many meters counts as a duplicate.
CITYDESK_DEDUPE_RADIUS_M=50
# ...if it was filed within this many days.
CITYDESK_DEDUPE_WINDOW_DAYS=30

# Ceilings on new reports per clock hour, per household and for the whole server.
CITYDESK_MAX_FILINGS_PER_USER_PER_HOUR=10
CITYDESK_MAX_FILINGS_PER_HOUR=200

# --- Open311 -----------------------------------------------------------
# Optional. Raises Boston's read rate limit. Request one at
# https://311.boston.gov/open311/app_requests/new
# (or https://boston2-production.spotmobile.net/open311/app_requests/new, the URL the discovery file gives)
BOSTON_OPEN311_API_KEY=
# Optional. Only needed if the SeeClickFix sandbox asks for one.
SEECLICKFIX_API_KEY=
# Writes go only to sandbox endpoints unless this is exactly "true".
ALLOW_PRODUCTION_WRITES=false

# --- MCP server --------------------------------------------------------
PORT=8787
# Comma-separated bearer tokens accepted by the MCP endpoint.
MCP_BEARER_TOKENS=dev-local-token
# Comma-separated browser origins allowed to call the MCP endpoint.
MCP_ALLOWED_ORIGINS=http://localhost:5173
# "memory" (local, persisted to .citydesk/store.json) or "dynamodb".
CITYDESK_STORE=memory
# "memory" gives 2025-era MCP clients sessions held in this process. Leave unset for stateless.
MCP_SESSIONS=
# Optional path of the address index built by `pnpm sync:addresses` (default: .citydesk/addresses.json.gz).
CITYDESK_ADDRESS_INDEX=

# --- Web client (apps/sim-client) ---------------------------------------
# Where the browser finds the MCP server. In the deployed stack this is "/mcp" (same origin).
VITE_MCP_URL=http://localhost:8787/mcp
# Polly engine for spoken replies: neural, standard, generative or long-form.
POLLY_ENGINE=neural
# Ceilings for the public backend: metered requests (assistant and speech) per UTC day, and
# requests per minute per address. Requests past either are refused before any AWS call.
DEMO_DAILY_REQUEST_CAP=600
DEMO_RATE_LIMIT_PER_MINUTE=40
# Most output tokens per assistant reply.
ASSISTANT_MAX_TOKENS=400

# --- Amazon Location ceilings -------------------------------------------
# Paid geocoding requests per day; past it, street addresses still resolve from the local index.
CITYDESK_MAX_GEOCODES_PER_DAY=1000
CITYDESK_MAX_STATIC_MAPS_PER_DAY=2000
