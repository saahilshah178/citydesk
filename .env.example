# Copy to .env (never commit .env). Keys live only in environment variables or SSM Parameter Store.

# --- AWS ---------------------------------------------------------------
AWS_REGION=us-east-1
# Bedrock model (or inference profile) ID used by the assistant through the Converse API.
BEDROCK_MODEL_ID=
# Amazon Location Service place index used for geocoding (created by infra/).
LOCATION_PLACE_INDEX=citydesk-places
# DynamoDB table for each user's filed and followed requests (created by infra/).
CITYDESK_TABLE=citydesk-user-requests
# Amazon Polly voice for spoken replies.
POLLY_VOICE_ID=Joanna

# --- Open311 -----------------------------------------------------------
# Optional. Raises Boston's read rate limit. Request one at
# https://311.boston.gov/open311/app_requests/new
BOSTON_OPEN311_API_KEY=
# Optional. Only needed if the SeeClickFix sandbox asks for one.
SEECLICKFIX_API_KEY=
# Writes go only to sandbox endpoints unless this is exactly "true".
ALLOW_PRODUCTION_WRITES=false

# --- MCP server --------------------------------------------------------
PORT=8787
# Comma-separated bearer tokens accepted by the MCP endpoint.
MCP_BEARER_TOKENS=dev-local-token
# Comma-separated browser origins allowed to call the MCP endpoint.
MCP_ALLOWED_ORIGINS=http://localhost:5173
# "memory" (local, optional JSON file) or "dynamodb".
CITYDESK_STORE=memory

# --- Sim client --------------------------------------------------------
VITE_MCP_URL=http://localhost:8787/mcp
