{
  "name": "citydesk-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "CityDesk: an Alexa+ style voice integration for city services, built as a self-hosted MCP server on Open311.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p scripts/tsconfig.json --noEmit",
    "test": "pnpm -r --if-present test",
    "smoke": "tsx scripts/smoke.ts",
    "replay:dupes": "tsx scripts/replay_dupes.ts",
    "dev:server": "pnpm --filter @citydesk/server dev",
    "dev:client": "pnpm --filter @citydesk/sim-client dev"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1149.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
